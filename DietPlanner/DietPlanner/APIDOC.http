# API call for register a user
###
POST http://127.0.0.1:8000/user
Content-Type: application/json

{
    "username":"user4",
    "email":"user4@gmail.com",
    # "password":"user2123",
    "phone":"8978960000",
    "password1":"user4123",
    "password2":"user4123"
}


# API call for token authentication (email,password),(phn,password)
###
POST http://127.0.0.1:8000/token 
Content-Type: application/json

{
    "username":"user1@gmail.com",
    "password":"user1123"
}

###
@token=ec5692b1460d8ac6c2d241501c93cdf423715c85

# API call for profile create
###
POST http://127.0.0.1:8000/profile
Content-Type: application/json
Authorization: Token {{token}} 

{
    "age":23,
    "weight":58.4,
    "height":1.67,
    "gender":"male",
    "activity_level":"active",
    "goal":"weight_gain"
}


# APi call for profile detail view
###
GET http://127.0.0.1:8000/detail 
Authorization: Token {{token}}

# API call for user profile update
###
PUT http://127.0.0.1:8000/detail 
Content-Type: application/json
Authorization: Token {{token}}

{
  "id": 4,
  "user": "user1",
  "age": 25,
  "gender": "male",
  "weight": "59.40",
  "height": "1.67",
  "target_weight": null,
  "duration": null,
  "activity_level": "active",
  "goal": "weight_gain",
  "daily_calories_goal": 3118,
  "profile_pic": null,
  "bmi": "20.94",
  "created_at": "2026-09-03T11:27:52.060530Z"
}



# API call for  foodlog create
###
POST http://127.0.0.1:8000/foodlog
Content-Type: application/json
Authorization: Token {{token}}

{
    "title":"oats",
    "meal_type":"break fast",
    "quantity":"100g",
    "calories":"300"
}


# API call for foodlog list view
###
GET http://127.0.0.1:8000/foodlog
Authorization: Token {{token}}


# API call for foodlog detail view

###
GET http://127.0.0.1:8000/foodlog/detail/1
Authorization: Token {{token}}